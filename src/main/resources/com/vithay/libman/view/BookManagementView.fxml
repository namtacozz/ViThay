<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="bookRootPane"
           fx:controller="com.vithay.libman.controller.BookManagementController"
           stylesheets="@../css/style.css" styleClass="bg-dark">

    <!-- MAIN VIEW CONTAINER -->
    <VBox fx:id="bookMainContainer" spacing="16" styleClass="bg-dark">
        <padding>
            <Insets top="24" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Header & Action Bar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Kho Sách" styleClass="title-large"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Secondary Utility Group (Proximity & Functional Grouping - B3.md) -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button onAction="#handleRefreshAllBooks" styleClass="btn-circle, btn-secondary">
                    <graphic>
                        <SVGPath content="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 H 17.65 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 H 20 V 4 L 17.65 6.35 Z" fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/>
                    </graphic>
                    <tooltip><Tooltip text="Làm mới dữ liệu kho sách"/></tooltip>
                </Button>
                <Button fx:id="btnExportBooks" onAction="#handleExportCsv" styleClass="btn-secondary" style="-fx-padding: 6 14;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <SVGPath content="M 19 9 h -4 V 3 H 9 v 6 H 5 l 7 7 l 7 -7 Z M 5 18 v 2 h 14 v -2 H 5 Z" fill="#B3B3B3" scaleX="0.65" scaleY="0.65"/>
                            <Label text="Xuất" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Xuất danh sách sách ra file CSV"/></tooltip>
                </Button>
            </HBox>
            <!-- Primary Action Call-to-Action -->
            <Button fx:id="btnAddBook" onAction="#handleOpenAddDialog" styleClass="btn-primary" style="-fx-padding: 6 16;">
                <graphic>
                    <HBox alignment="CENTER" spacing="6">
                        <SVGPath content="M 19 13 h -6 v 6 h -2 v -6 H 5 v -2 h 6 V 5 h 2 v 6 h 6 v 2 Z" fill="#000000" scaleX="0.65" scaleY="0.65"/>
                        <Label text="Thêm" style="-fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="Thêm đầu sách mới vào kho"/></tooltip>
            </Button>
        </HBox>

        <!-- Breadcrumb Navigation (One-Window Drilldown) -->
        <HBox fx:id="breadcrumbContainer" alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb-container"/>

        <!-- Filter & Search Toolbar (B3.md: Visual Hierarchy Top-Left Priority + Grouping) -->
        <HBox fx:id="filterToolbar" alignment="CENTER_LEFT" spacing="12" styleClass="bg-surface">
            <padding>
                <Insets top="10" right="14" bottom="10" left="14"/>
            </padding>
            <!-- Priority 1 (Top-Left): Quick Search Field -->
            <TextField fx:id="txtSearchBook" promptText="Tìm kiếm" prefWidth="280"
                       styleClass="search-field" onKeyReleased="#handleSearchBook"/>

            <!-- Grouped Filters -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="filter-group-box">
                <Label text="Trạng thái:" styleClass="form-label" style="-fx-font-size: 11px;"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="130" styleClass="form-control" onAction="#handleStatusFilter"/>
                <Button fx:id="btnToggleAdvancedFilter" text="Lọc nâng cao ▾" onAction="#handleToggleAdvancedFilter"
                        styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5 10;">
                    <tooltip><Tooltip text="Mở rộng bộ lọc chuyên sâu (tác giả, thể loại, giá, vị trí kệ, tồn kho)"/></tooltip>
                </Button>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Workspace Panel Tools: Closable & Movable (B3.md) -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <!-- Closable Panel Toggle -->
                <Button fx:id="btnToggleInspector" onAction="#toggleInspectorPanel"
                        styleClass="btn-secondary, segmented-view-active" style="-fx-padding: 5 10;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="5">
                            <SVGPath content="M 3 3 h 18 v 18 H 3 Z M 15 5 v 14 h 4 V 5 Z" fill="#B3B3B3" scaleX="0.65" scaleY="0.65"/>
                            <Label text="Chi tiết" style="-fx-text-fill: #E5E7EB; -fx-font-size: 11px;"/>
                        </HBox>
                    </graphic>
                    <tooltip><Tooltip text="Đóng / mở Panel Chi Tiết"/></tooltip>
                </Button>

                <!-- Movable Workspace Panel Swap (Left ⇄ Right) -->
                <Button fx:id="btnSwapPanels" onAction="#handleSwapPanels"
                        styleClass="btn-circle, btn-secondary" style="-fx-min-width: 30px; -fx-pref-width: 30px; -fx-min-height: 30px; -fx-pref-height: 30px; -fx-padding: 0;">
                    <graphic>
                        <SVGPath content="M 6.99 11 L 3 15 l 3.99 4 v -3 H 14 v -2 H 6.99 v -3 Z M 21 9 l -3.99 -4 v 3 H 10 v 2 h 7.01 v 3 L 21 9 Z" fill="#B3B3B3" scaleX="0.65" scaleY="0.65"/>
                    </graphic>
                    <tooltip><Tooltip text="Đổi bên"/></tooltip>
                </Button>
            </HBox>

            <!-- Segmented View Toggle Buttons (Table / Grid) -->
            <HBox styleClass="segmented-view-group" alignment="CENTER_LEFT" spacing="2">
                <Button fx:id="btnTableView" onAction="#handleSwitchToTableView"
                        styleClass="segmented-view-btn, segmented-view-active" style="-fx-padding: 5 10;">
                    <graphic>
                        <SVGPath content="M 3 6 H 21 M 3 12 H 21 M 3 18 H 21" styleClass="view-toggle-icon" strokeWidth="2.2" stroke="#B3B3B3" fill="TRANSPARENT"/>
                    </graphic>
                    <tooltip><Tooltip text="Chế độ xem dạng Bảng chi tiết"/></tooltip>
                </Button>
                <Button fx:id="btnGridView" onAction="#handleSwitchToGridView"
                        styleClass="segmented-view-btn" style="-fx-padding: 5 10;">
                    <graphic>
                        <SVGPath content="M 3 3 H 10 V 10 H 3 Z M 14 3 H 21 V 10 H 14 Z M 3 14 H 10 V 21 H 3 Z M 14 14 H 21 V 21 H 14 Z" styleClass="view-toggle-icon" fill="#B3B3B3"/>
                    </graphic>
                    <tooltip><Tooltip text="Chế độ xem dạng Lưới thẻ (Spotify Grid)"/></tooltip>
                </Button>
            </HBox>
        </HBox>

        <!-- Extras on Demand: Advanced Filter Pane -->
        <VBox fx:id="advancedFilterPane" visible="false" managed="false" spacing="10" styleClass="bg-surface"
              style="-fx-padding: 12 16; -fx-background-radius: 8px; -fx-border-color: #282828; -fx-border-radius: 8px; -fx-border-width: 1px;">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4">
                    <Label text="Tác giả:" styleClass="form-label"/>
                    <ComboBox fx:id="authorFilterCombo" prefWidth="150" styleClass="form-control" onAction="#handleAuthorFilter"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Thể loại:" styleClass="form-label"/>
                    <ComboBox fx:id="comboAdvCategory" prefWidth="150" styleClass="form-control" onAction="#handleAdvancedFilterChanged"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Vị trí kệ:" styleClass="form-label"/>
                    <ComboBox fx:id="comboAdvShelf" prefWidth="150" styleClass="form-control" editable="true" onAction="#handleAdvancedFilterChanged"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Khoảng giá (VNĐ):" styleClass="form-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <TextField fx:id="txtAdvMinPrice" promptText="Từ" prefWidth="85" styleClass="form-control" onKeyReleased="#handleAdvancedFilterChanged"/>
                        <Label text="-" styleClass="text-muted"/>
                        <TextField fx:id="txtAdvMaxPrice" promptText="Đến" prefWidth="85" styleClass="form-control" onKeyReleased="#handleAdvancedFilterChanged"/>
                    </HBox>
                </VBox>
                <VBox spacing="4">
                    <Label text="Tồn kho:" styleClass="form-label"/>
                    <ComboBox fx:id="comboAdvStockStatus" prefWidth="140" styleClass="form-control" onAction="#handleAdvancedFilterChanged"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="BOTTOM_RIGHT" spacing="4">
                    <Label text=""/>
                    <Button text="✕ Đặt lại bộ lọc" onAction="#handleResetAdvancedFilter" styleClass="btn-secondary" style="-fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Two-Panel Selector: Master (Table/Grid/Circulation) + Detail Inspector -->
        <SplitPane fx:id="bookSplitPane" VBox.vgrow="ALWAYS" dividerPositions="0.72" styleClass="split-inspector-pane">
            <items>
                <!-- Master Area: Holds Table, Grid Views, and In-Place Circulation History (72%) -->
                <StackPane fx:id="bookMasterPane" minWidth="400">
                    <!-- Books Table -->
                    <TableView fx:id="booksTable" VBox.vgrow="ALWAYS" prefHeight="450">
                        <columns>
                            <TableColumn fx:id="colBookId" text="Mã" minWidth="65" prefWidth="70"/>
                            <TableColumn fx:id="colBookTitle" text="Tên Sách" minWidth="180" prefWidth="230"/>
                            <TableColumn fx:id="colBookAuthor" text="Tác Giả" minWidth="120" prefWidth="150"/>
                            <TableColumn fx:id="colBookCategory" text="Thể Loại" minWidth="110" prefWidth="130"/>
                            <TableColumn fx:id="colBookShelf" text="Vị Trí" visible="false"/>
                            <TableColumn fx:id="colBookPrice" text="Đơn Giá" minWidth="85" prefWidth="95"/>
                            <TableColumn fx:id="colBookAvailable" text="Tồn" minWidth="55" prefWidth="65"/>
                            <TableColumn fx:id="colBookStatus" text="Trạng Thái" minWidth="105" prefWidth="115"/>
                            <TableColumn fx:id="colBookActions" text="Thao Tác" minWidth="95" prefWidth="105"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Books Grid Card View -->
                    <ScrollPane fx:id="booksGridScrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                                visible="false" managed="false" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="booksGridPane" hgap="14" vgap="14" style="-fx-padding: 12;"/>
                    </ScrollPane>

                    <!-- In-Place Circulation History View (One-Window Drilldown) -->
                    <VBox fx:id="circulationHistoryPane" visible="false" managed="false" spacing="12" VBox.vgrow="ALWAYS"
                          styleClass="bg-surface" style="-fx-padding: 16; -fx-background-radius: 8px;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Button text="← Quay lại danh sách sách" onAction="#handleBackFromCirculationHistory" styleClass="btn-secondary" style="-fx-font-size: 12px;"/>
                            <VBox spacing="2">
                                <Label fx:id="lblCirculationBookTitle" text="Lịch Sử Lưu Hành Sách" styleClass="title-large" style="-fx-font-size: 16px;"/>
                                <Label fx:id="lblCirculationBookMeta" text="Lịch sử mượn trả và luân chuyển của cuốn sách trong hệ thống" styleClass="text-muted" style="-fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>
                        <TableView fx:id="circulationTable" VBox.vgrow="ALWAYS" prefHeight="400">
                            <columns>
                                <TableColumn fx:id="colTxId" text="Mã Phiếu" prefWidth="85"/>
                                <TableColumn fx:id="colTxReaderName" text="Độc Giả" prefWidth="140"/>
                                <TableColumn fx:id="colTxBorrowDate" text="Ngày Mượn" prefWidth="95"/>
                                <TableColumn fx:id="colTxDueDate" text="Hạn Trả" prefWidth="95"/>
                                <TableColumn fx:id="colTxReturnDate" text="Ngày Trả" prefWidth="95"/>
                                <TableColumn fx:id="colTxType" text="Hình Thức" prefWidth="110"/>
                                <TableColumn fx:id="colTxStatus" text="Trạng Thái" prefWidth="95"/>
                                <TableColumn fx:id="colTxFine" text="Tiền Phạt" prefWidth="85"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </StackPane>

                <!-- Right Pane: Detail Inspector (28%) (B3.md Closable Panel) -->
                <VBox fx:id="detailInspectorPane" minWidth="260" prefWidth="300" maxWidth="450" spacing="0"
                      styleClass="bg-surface" style="-fx-background-radius: 8px;">
                    <!-- Closable Panel Header Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 14 8 14; -fx-border-color: #282828; -fx-border-width: 0 0 1 0;">
                        <SVGPath content="M 3 3 h 18 v 18 H 3 Z M 15 5 v 14 h 4 V 5 Z" fill="#1DB954" scaleX="0.65" scaleY="0.65"/>
                        <Label text="Chi tiết" style="-fx-font-size: 13px; -fx-text-fill: #1DB954; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#closeInspectorPanel" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3 8; -fx-background-radius: 50%;">
                            <tooltip><Tooltip text="Đóng panel chi tiết để mở rộng bảng 100% (B3.md Closable Panel)"/></tooltip>
                        </Button>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="14" style="-fx-padding: 16;">
                            <!-- Header / Category & Status Badge -->
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="lblInspectorCategory" text="Thể Loại" styleClass="cat-pill, cat-pill-dark"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblInspectorStatus" text="Khả dụng" styleClass="badge-available"/>
                            </HBox>

                            <!-- Large Cover Art -->
                            <VBox alignment="CENTER" style="-fx-padding: 4 0;">
                                <ImageView fx:id="imgInspectorCover" fitWidth="150" fitHeight="200" preserveRatio="false"
                                           style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 12, 0, 0, 4);"/>
                            </VBox>

                            <!-- Title & Author -->
                            <VBox spacing="4" alignment="CENTER">
                                <Label fx:id="lblInspectorTitle" text="Tên Sách" styleClass="inspector-header" wrapText="true" textAlignment="CENTER"/>
                                <Label fx:id="lblInspectorAuthor" text="Tác Giả" styleClass="text-muted" wrapText="true" textAlignment="CENTER"/>
                            </VBox>

                            <!-- Shelf Box -->
                            <VBox styleClass="inspector-shelf-box" spacing="4">
                                <Label text="VỊ TRÍ" styleClass="form-label" style="-fx-font-size: 10px; -fx-text-fill: #1DB954;"/>
                                <Label fx:id="lblInspectorShelf" text="Khu A - Kệ 01" styleClass="inspector-shelf-location"/>
                            </VBox>

                            <!-- Details: ISBN, Price, Available Copies -->
                            <GridPane hgap="8" vgap="8" styleClass="bg-dark" style="-fx-padding: 10 12; -fx-background-radius: 6px;">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" prefWidth="95"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Mã ISBN:" styleClass="inspector-meta-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="lblInspectorIsbn" text="--" styleClass="inspector-meta-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Đơn Giá:" styleClass="inspector-meta-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="lblInspectorPrice" text="-- đ" styleClass="inspector-meta-value" style="-fx-text-fill: #1DB954;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Khả Dụng:" styleClass="inspector-meta-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="lblInspectorCopies" text="-- / -- bản" styleClass="inspector-meta-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>

                            <!-- Action Buttons -->
                            <VBox spacing="8">
                                <Button fx:id="btnOpenFullDetail" text="Chi tiết toàn diện" maxWidth="Infinity" styleClass="btn-secondary" onAction="#handleOpenFullDetailView"/>
                                <Button fx:id="btnInspectorBorrow" text="Lập Phiếu Mượn" maxWidth="Infinity" styleClass="btn-primary" onAction="#handleInspectorQuickBorrow"/>
                                <HBox spacing="8">
                                    <Button fx:id="btnInspectorEdit" text="Chỉnh Sửa" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary" onAction="#handleInspectorEdit"/>
                                    <Button fx:id="btnInspectorDelete" text="Xoá" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-danger" onAction="#handleInspectorDelete"/>
                                </HBox>
                            </VBox>

                            <!-- Placeholder for Intriguing Branches (Task 4) -->
                            <VBox fx:id="inspectorBranchesBox" spacing="8"/>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </items>
        </SplitPane>

        <!-- Two-Tier Full Book Detail View: 1/4 Left Preview + 3/4 Right Description & Reader Discussions -->
        <HBox fx:id="bookFullDetailPane" visible="false" managed="false" VBox.vgrow="ALWAYS" spacing="20">
            <!-- Left Column: 1/4 Preview Pane (~280-320px) -->
            <VBox minWidth="280" prefWidth="300" maxWidth="340" spacing="12" styleClass="bg-surface"
                  style="-fx-padding: 16; -fx-background-radius: 8px;">
                <HBox alignment="CENTER_LEFT">
                    <Button text="← Quay lại kho sách" onAction="#handleBackFromFullDetail" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                </HBox>

                <!-- Cover Image -->
                <VBox alignment="CENTER" style="-fx-padding: 8 0;">
                    <ImageView fx:id="imgFullDetailCover" fitWidth="180" fitHeight="250" preserveRatio="false"
                               style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 14, 0, 0, 4);"/>
                </VBox>

                <!-- Title & Author -->
                <VBox spacing="4" alignment="CENTER">
                    <Label fx:id="lblFullDetailTitle" text="Tên Sách" styleClass="title-large" style="-fx-font-size: 15px;" wrapText="true" textAlignment="CENTER"/>
                    <Label fx:id="lblFullDetailAuthor" text="Tác Giả" styleClass="text-muted" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Category & Status Pill -->
                <HBox alignment="CENTER" spacing="8">
                    <Label fx:id="lblFullDetailCategory" text="Thể Loại" styleClass="cat-pill, cat-pill-dark"/>
                    <Label fx:id="lblFullDetailStatus" text="Khả dụng" styleClass="badge-available"/>
                </HBox>

                <!-- Shelf Box -->
                <VBox styleClass="inspector-shelf-box" spacing="4">
                    <Label text="VỊ TRÍ" styleClass="form-label" style="-fx-font-size: 10px; -fx-text-fill: #1DB954;"/>
                    <Label fx:id="lblFullDetailShelf" text="Khu A - Kệ 01" styleClass="inspector-shelf-location"/>
                </VBox>

                <!-- Metadata Grid: ISBN, Price, Available Copies -->
                <GridPane hgap="8" vgap="6" styleClass="bg-dark" style="-fx-padding: 10 12; -fx-background-radius: 6px;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="85"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Mã Sách:" styleClass="inspector-meta-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblFullDetailId" text="--" styleClass="inspector-meta-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Mã ISBN:" styleClass="inspector-meta-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblFullDetailIsbn" text="--" styleClass="inspector-meta-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Đơn Giá:" styleClass="inspector-meta-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblFullDetailPrice" text="-- đ" styleClass="inspector-meta-value" style="-fx-text-fill: #1DB954;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Khả Dụng:" styleClass="inspector-meta-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="lblFullDetailCopies" text="-- / -- bản" styleClass="inspector-meta-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Borrow Action -->
                <Button fx:id="btnFullDetailBorrow" text="Lập Phiếu Mượn" maxWidth="Infinity" styleClass="btn-primary" onAction="#handleInspectorQuickBorrow"/>
            </VBox>

            <!-- Right Column: 3/4 Description & Reader Discussions -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="16" style="-fx-padding: 0 4 20 4;">
                    <!-- Section 1: Book Description -->
                    <VBox spacing="10" styleClass="bg-surface" style="-fx-padding: 20; -fx-background-radius: 8px;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="TỔNG QUAN &amp; TÓM TẮT TÁC PHẨM" styleClass="title-large" style="-fx-font-size: 15px; -fx-text-fill: #1DB954;"/>
                        </HBox>
                        <Label fx:id="lblFullDetailDescription" styleClass="full-detail-description" wrapText="true"/>
                    </VBox>

                    <!-- Section 2: Reader Discussions & Reviews -->
                    <VBox spacing="14" styleClass="bg-surface" style="-fx-padding: 20; -fx-background-radius: 8px;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="lblFullDetailReviewHeader" text="BÀN LUẬN &amp; ĐÁNH GIÁ TỪ ĐỘC GIẢ" styleClass="title-large" style="-fx-font-size: 15px;"/>
                        </HBox>

                        <!-- Comment Submission Box -->
                        <VBox spacing="10" styleClass="bg-dark" style="-fx-padding: 14; -fx-background-radius: 8px;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="Gửi bình luận / nhận xét mới:" styleClass="form-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Đánh giá:" styleClass="form-label"/>
                                <ComboBox fx:id="comboReviewRating" prefWidth="160" styleClass="form-control"/>
                            </HBox>
                            <TextArea fx:id="txtReviewContent" promptText="Chia sẻ cảm nhận, góc nhìn hoặc bàn luận về cuốn sách này..."
                                      prefRowCount="3" wrapText="true" styleClass="form-control"/>
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Label fx:id="lblReviewStatus" style="-fx-font-size: 12px;"/>
                                <Button text="Gửi Bình Luận" onAction="#handleSendReview" styleClass="btn-primary" style="-fx-padding: 6 16;"/>
                            </HBox>
                        </VBox>

                        <!-- Discussion Comments Feed -->
                        <VBox fx:id="reviewsContainer" spacing="10"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </VBox>

    <!-- IN-WINDOW OVERLAY MODAL FOR ADD/EDIT BOOK -->
    <StackPane fx:id="bookModalOverlay" visible="false" managed="false" styleClass="auth-overlay">
        <Pane onMouseClicked="#closeBookModal"/>
        <VBox fx:id="bookModalBox" maxWidth="540" maxHeight="-Infinity" StackPane.alignment="CENTER" styleClass="auth-modal" spacing="14">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label fx:id="lblBookModalTitle" text="Thêm Sách Mới" styleClass="title-large"/>
                    <Label text="Nhập thông tin chi tiết đầu sách theo chuẩn thư viện (SRS Mục 5.3)" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#closeBookModal" styleClass="btn-secondary" style="-fx-padding: 4 10; -fx-background-radius: 50%;"/>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" maxHeight="440">
                <VBox spacing="14" style="-fx-padding: 4 6 4 2;">
                    <!-- Cover Image Picker & Drag Drop Target -->
                    <HBox fx:id="boxCoverPicker" spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: #202020; -fx-padding: 12 14; -fx-background-radius: 8px; -fx-border-color: #2F2F2F; -fx-border-radius: 8px; -fx-border-width: 1px;">
                        <StackPane fx:id="paneCoverThumb" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 2);">
                            <ImageView fx:id="imgModalCoverPreview" fitWidth="70" fitHeight="95" preserveRatio="false" style="-fx-background-radius: 4px;"/>
                        </StackPane>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Ảnh Bìa Sách:" styleClass="form-label" style="-fx-font-weight: bold;"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button text="📁 Chọn ảnh bìa..." onAction="#handleChooseCoverImage" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                                <Button text="↺ Mặc định" onAction="#handleResetCoverImage" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 8;"/>
                            </HBox>
                            <Label fx:id="lblCoverPathHint" text="Kéo thả file ảnh (.jpg, .png) vào đây hoặc bấm nút chọn ảnh từ máy." wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                    </HBox>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="130" prefWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="240"/>
                        </columnConstraints>

                        <Label text="Mã Sách:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookId" promptText="VD: BK037" styleClass="form-control" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Tên Sách:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookTitle" promptText="Nhập tên sách" styleClass="form-control" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Tác Giả:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookAuthor" promptText="Tác giả / Dịch giả" styleClass="form-control" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Thể Loại:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="comboModalBookCategory" maxWidth="Infinity" styleClass="form-control" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Vị Trí Kệ Sách:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookShelf" promptText="VD: Khu TN - Kệ 01" styleClass="form-control" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Mã ISBN:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookIsbn" promptText="978-..." styleClass="form-control" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Đơn Giá (VNĐ):" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookPrice" promptText="120000" styleClass="form-control" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Tổng Bản Sách:" styleClass="form-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtModalBookCopies" promptText="5" styleClass="form-control" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <Label text="Trạng Thái:" styleClass="form-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="comboModalBookStatus" maxWidth="Infinity" styleClass="form-control" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>

            <Label fx:id="lblBookModalError" text="" style="-fx-font-weight: bold;"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Hủy Bỏ" onAction="#closeBookModal" styleClass="btn-secondary"/>
                <Button text="Lưu Sách" onAction="#handleSaveBookModal" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
