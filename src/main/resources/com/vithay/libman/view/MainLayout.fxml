<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootStackPane"
           fx:controller="com.vithay.libman.controller.MainLayoutController"
           stylesheets="@../css/style.css"
           prefWidth="1320" prefHeight="820" styleClass="bg-dark">

    <!-- LAYER 1: MAIN APPLICATION BORDERPANE -->
    <BorderPane fx:id="mainContainer" styleClass="bg-dark">

        <!-- TOP HEADER: LOGO ON TOP-LEFT, SEARCH AND ACTIONS ON RIGHT -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="0" styleClass="top-header">
                <!-- Brand Logo: Positioned at top-left corner directly above sidebar -->
                <HBox alignment="CENTER_LEFT" spacing="12" prefWidth="250" minWidth="250" maxWidth="250" style="-fx-padding: 0 0 0 16;">
                    <ImageView fx:id="logoImageView" fitWidth="32" fitHeight="32" preserveRatio="true">
                        <Image url="@../images/logo.png"/>
                    </ImageView>
                    <VBox spacing="1" alignment="CENTER_LEFT">
                        <Label text="LibMan" styleClass="sidebar-logo-text"/>
                        <Label text="Thư Viện Chuẩn Quốc Gia" style="-fx-font-size: 10px; -fx-text-fill: #727272;"/>
                    </VBox>
                </HBox>

                <!-- Header Actions Area: Aligned straight above main content view -->
                <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS" style="-fx-padding: 0 20 0 16;">
                    <!-- Search Box: Starts at x = 250 + 16 = 266px, aligned straight with dropdown below -->
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-field" prefWidth="440">
                        <SVGPath content="M 9 2 C 5.13 2 2 5.13 2 9 C 2 12.87 5.13 16 9 16 C 10.61 16 12.09 15.45 13.28 14.53 L 17.38 18.62 C 17.72 18.96 18.28 18.96 18.62 18.62 C 18.96 18.28 18.96 17.72 18.62 17.38 L 14.53 13.28 C 15.45 12.09 16 10.61 16 9 C 16 5.13 12.87 2 9 2 Z M 9 4 C 11.76 4 14 6.24 14 9 C 14 11.76 11.76 14 9 14 C 6.24 14 4 11.76 4 9 C 4 6.24 6.24 4 9 4 Z" fill="#727272" scaleX="0.7" scaleY="0.7"/>
                        <TextField fx:id="headerSearchField" promptText="Tìm kiếm sách, tác giả, thể loại, độc giả..."
                                   style="-fx-background-color: transparent; -fx-text-fill: inherit; -fx-prompt-text-fill: #727272;"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Action Icons -->
                    <Button fx:id="btnNotification" styleClass="btn-circle, btn-header-bell" onAction="#handleNotificationClick">
                        <graphic>
                            <SVGPath mouseTransparent="true" content="M 12 2 C 10.9 2 10 2.9 10 4 C 7.2 4.7 5 7.2 5 10.3 L 5 15 L 3 17 L 3 18 L 21 18 L 21 17 L 19 15 L 19 10.3 C 19 7.2 16.8 4.7 14 4 C 14 2.9 13.1 2 12 2 Z M 10 19 C 10 20.1 10.9 21 12 21 C 13.1 21 14 20.1 14 19 L 10 19 Z" fill="#FFFFFF" scaleX="0.6" scaleY="0.6"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnHeaderSettings" styleClass="btn-circle, btn-header-gear" onAction="#handleHeaderSettingsClick">
                        <graphic>
                            <SVGPath mouseTransparent="true" content="M 19.4 13 C 19.4 12.7 19.5 12.3 19.5 12 C 19.5 11.7 19.4 11.3 19.4 11 L 21.5 9.4 C 21.7 9.2 21.8 8.9 21.6 8.7 L 19.6 5.2 C 19.5 5 19.2 4.9 19 5 L 16.5 6 C 16 5.6 15.4 5.3 14.8 5.1 L 14.4 2.4 C 14.4 2.2 14.2 2 13.9 2 L 10 2 C 9.8 2 9.6 2.2 9.5 2.4 L 9.2 5.1 C 8.6 5.3 8 5.6 7.5 6 L 5 5 C 4.8 4.9 4.5 5 4.4 5.2 L 2.4 8.7 C 2.2 8.9 2.3 9.2 2.5 9.4 L 4.6 11 C 4.6 11.3 4.5 11.7 4.5 12 C 4.5 12.3 4.6 12.7 4.6 13 L 2.5 14.6 C 2.3 14.8 2.2 15.1 2.4 15.3 L 4.4 18.8 C 4.5 19 4.8 19.1 5 19 L 7.5 18 C 8 18.4 8.6 18.7 9.2 18.9 L 9.5 21.6 C 9.6 21.8 9.8 22 10 22 L 13.9 22 C 14.2 22 14.4 21.8 14.4 21.6 L 14.8 18.9 C 15.4 18.7 16 18.4 16.5 18 L 19 19 C 19.2 19.1 19.5 19 19.6 18.8 L 21.6 15.3 C 21.8 15.1 21.7 14.8 21.5 14.6 L 19.4 13 Z M 12 15.5 C 10.1 15.5 8.5 13.9 8.5 12 C 8.5 10.1 10.1 8.5 12 8.5 C 13.9 8.5 15.5 10.1 15.5 12 C 15.5 13.9 13.9 15.5 12 15.5 Z" fill="#FFFFFF" scaleX="0.6" scaleY="0.6"/>
                        </graphic>
                    </Button>

                    <!-- User Profile Chip (Click to open Account Settings or Login) -->
                    <HBox fx:id="userProfileBox" alignment="CENTER_LEFT" spacing="10" styleClass="user-profile-chip" onMouseClicked="#handleProfileClick" style="-fx-cursor: hand;">
                        <ImageView fx:id="userAvatarImageView" fitWidth="28" fitHeight="28" preserveRatio="true">
                            <Image url="@../images/avatar_dark.png"/>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT" spacing="1">
                            <Label fx:id="lblHeaderUserName" text="Chưa đăng nhập" styleClass="header-user-name"/>
                            <Label fx:id="lblHeaderUserRole" text="Nhấn để đăng nhập / đăng ký" styleClass="header-user-role"/>
                        </VBox>
                    </HBox>
                </HBox>
            </HBox>
        </top>

        <!-- LEFT SIDEBAR: BRAVE-STYLE VERTICAL TABS WITH VECTOR ICONS & COLLAPSIBLE/PINNING -->
        <left>
            <VBox fx:id="sidebarContainer" prefWidth="250" minWidth="64" maxWidth="250" styleClass="bg-sidebar" spacing="6">
                <padding>
                    <Insets top="10" right="10" bottom="16" left="10"/>
                </padding>

                <!-- Top Pin & Header Bar of Sidebar -->
                <HBox fx:id="sidebarHeaderBox" alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 0 4 4 4;">
                    <Label fx:id="lblSidebarTitle" text="ĐIỀU HƯỚNG" styleClass="sidebar-category-label" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Region fx:id="sidebarHeaderSpacer" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnPinSidebar" onAction="#handleTogglePinSidebar" styleClass="btn-pin-sidebar">
                        <graphic>
                            <SVGPath fx:id="pinIconPath" mouseTransparent="true" content="M 12 17 V 22 M 5 17 H 19 M 7 17 L 9 2 H 15 L 17 17" styleClass="sidebar-svg-icon" scaleX="0.75" scaleY="0.75"/>
                        </graphic>
                        <tooltip><Tooltip fx:id="pinTooltip" text="Ghim thanh bên (không tự động thu nhỏ)"/></tooltip>
                    </Button>
                </HBox>

                <!-- Navigation Scroll Container -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="4" style="-fx-background-color: transparent;">
                        
                        <!-- Section: Menu -->
                        <Label fx:id="lblSecMenu" text="MENU CHÍNH" styleClass="sidebar-category-label"/>
                        <Button fx:id="btnNavHome" text="Trang chủ" onAction="#handleNavHome" maxWidth="Infinity" styleClass="nav-item, nav-item-active">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 3 9 L 12 2 L 21 9 V 20 C 21 21.1 20.1 22 19 22 H 5 C 3.9 22 3 21.1 3 20 Z M 9 22 V 12 H 15 V 22 Z" styleClass="sidebar-svg-icon" scaleX="0.75" scaleY="0.75"/>
                            </graphic>
                            <tooltip><Tooltip text="Trang chủ - Tổng quan chỉ số"/></tooltip>
                        </Button>

                        <!-- Section: Quản lý sách -->
                        <Label fx:id="lblSecBooks" text="KHO SÁCH" styleClass="sidebar-category-label"/>
                        
                        <!-- Kho Sách Parent Row with Expand/Collapse Chevron -->
                        <HBox alignment="CENTER_LEFT" spacing="2" maxWidth="Infinity">
                            <Button fx:id="btnNavBooks" text="Kho sách" onAction="#handleNavBooks" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="nav-item">
                                <graphic>
                                    <SVGPath mouseTransparent="true" content="M 4 19.5 A 2.5 2.5 0 0 1 6.5 17 H 20 M 6.5 2 H 20 V 22 H 6.5 A 2.5 2.5 0 0 1 4 19.5 V 4.5 A 2.5 2.5 0 0 1 6.5 2 Z" styleClass="sidebar-svg-icon" scaleX="0.75" scaleY="0.75"/>
                                </graphic>
                                <tooltip><Tooltip text="Kho sách - Danh mục và tra cứu"/></tooltip>
                            </Button>
                            <Button fx:id="btnToggleCategories" text="▾ Thể loại" onAction="#handleToggleCategories"
                                    styleClass="btn-toggle-categories">
                                <tooltip><Tooltip text="Bấm để ẩn / hiện danh mục thể loại"/></tooltip>
                            </Button>
                        </HBox>

                        <!-- Collapsible Categories Sub-Menu with Theme-Aware Badges -->
                        <VBox fx:id="categorySubmenuContainer" spacing="3" managed="true" visible="true">
                            <Button text="Lý luận chính trị &amp; Triết học" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="01" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Văn học kinh điển" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="02" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Toán học &amp; Khoa học tự nhiên" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="03" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Lịch sử &amp; Địa lý" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="04" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Khoa học viễn tưởng" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="05" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Kỹ năng sống &amp; Tâm lý" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="06" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Hồi ký &amp; Tự truyện" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="07" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Tiểu thuyết hiện đại" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="08" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Công nghệ thông tin" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="09" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Ngoại ngữ &amp; Từ điển" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="10" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                            <Button text="Truyện tranh &amp; Sách thiếu nhi" onAction="#handleSubCategoryClick" maxWidth="Infinity" styleClass="subnav-item">
                                <graphic><Label text="11" styleClass="cat-pill, cat-pill-dark"/></graphic>
                            </Button>
                        </VBox>

                        <Button fx:id="btnNavCategories" text="Quản lý thể loại (Mã loại)" onAction="#handleNavCategories" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 20.59 13.41 L 13.42 20.58 C 12.64 21.36 11.37 21.36 10.59 20.58 L 2 12 V 2 H 12 L 20.59 10.59 C 21.37 11.37 21.37 12.64 20.59 13.41 Z M 7 7 A 1 1 0 1 0 7 7.01" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Quản lý thể loại và mã loại sách"/></tooltip>
                        </Button>

                        <!-- Section: Quản lý độc giả -->
                        <Label fx:id="lblSecReaders" text="QUẢN LÝ ĐỘC GIẢ" styleClass="sidebar-category-label"/>
                        <Button fx:id="btnNavReaders" text="Hồ sơ độc giả &amp; Cấp thẻ" onAction="#handleNavReaders" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 17 21 V 19 C 17 16.79 15.21 15 13 15 H 5 C 2.79 15 1 16.79 1 19 V 21 M 9 11 A 4 4 0 1 0 9 3 A 4 4 0 0 0 9 11 Z M 23 21 V 19 C 23 17.14 21.6 15.58 19.8 15.13 M 16 3.13 A 4 4 0 0 1 16 10.87" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Hồ sơ độc giả &amp; Cấp thẻ thư viện"/></tooltip>
                        </Button>

                        <!-- Section: Mượn & Trả -->
                        <Label fx:id="lblSecBorrow" text="MƯỢN &amp; TRẢ SÁCH" styleClass="sidebar-category-label"/>
                        <Button fx:id="btnNavBorrowReturn" text="Bàn lưu hành (Desk)" onAction="#handleNavBorrowReturn" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 8 3 L 4 7 L 8 11 M 4 7 H 20 M 16 21 L 20 17 L 16 13 M 20 17 H 4" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Bàn lưu hành mượn - trả sách (Desk)"/></tooltip>
                        </Button>
                        <Button fx:id="btnNavReturnBook" text="Xử lý trả &amp; bồi hoàn" onAction="#handleNavReturnBook" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 9 11 L 12 14 L 22 4 M 21 12 V 19 C 21 20.1 20.1 21 19 21 H 5 C 3.9 21 3 20.1 3 19 V 5 C 3 3.9 3.9 3 5 3 H 16" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Xử lý trả sách và ghi nhận bồi hoàn"/></tooltip>
                        </Button>
                        <Button fx:id="btnNavReaderBorrow" text="Đăng ký mượn sách" onAction="#handleOpenReaderBorrowModal" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 12 5 V 19 M 5 12 H 19 M 4 19.5 A 2.5 2.5 0 0 1 6.5 17 H 20 M 6.5 2 H 20 V 22 H 6.5" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Đăng ký mượn sách trực tuyến (Dành cho Độc Giả)"/></tooltip>
                        </Button>
                        <Button fx:id="btnNavTransactions" text="Lịch sử phiếu mượn" onAction="#handleNavTransactions" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 14 2 H 6 C 4.9 2 4 2.9 4 4 V 20 C 4 21.1 4.9 22 6 22 H 18 C 19.1 22 20 21.1 20 20 V 8 Z M 14 2 V 8 H 20 M 12 18 A 4 4 0 1 0 12 10 A 4 4 0 0 0 12 18 Z M 12 12 V 14 L 13.5 15" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Tra cứu lịch sử phiếu mượn"/></tooltip>
                        </Button>

                        <!-- Section: Thống kê & Quản trị -->
                        <Label fx:id="lblSecAdmin" text="BÁO CÁO &amp; HỆ THỐNG" styleClass="sidebar-category-label"/>
                        <Button fx:id="btnNavStats" text="Thống kê thư viện" onAction="#handleNavStats" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 18 20 V 10 M 12 20 V 4 M 6 20 V 14" styleClass="sidebar-svg-icon" scaleX="0.75" scaleY="0.75"/>
                            </graphic>
                            <tooltip><Tooltip text="Báo cáo thống kê thư viện"/></tooltip>
                        </Button>
                        <Button fx:id="btnNavRecycleBin" text="Thùng rác &amp; Khôi phục" onAction="#handleNavRecycleBin" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 3 6 H 21 M 19 6 V 20 A 2 2 0 0 1 17 22 H 7 A 2 2 0 0 1 5 20 V 6 M 8 6 V 4 A 2 2 0 0 1 10 2 H 14 A 2 2 0 0 1 16 4 V 6 M 10 11 V 17 M 14 11 V 17" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Thùng rác &amp; Khôi phục dữ liệu đã xóa"/></tooltip>
                        </Button>
                        <Button fx:id="btnNavSettings" text="Cài đặt quy định (SRS)" onAction="#handleNavSettings" maxWidth="Infinity" styleClass="nav-item">
                            <graphic>
                                <SVGPath mouseTransparent="true" content="M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 0 0 12 15 Z M 19.4 15 A 1.65 1.65 0 0 0 19.73 16.82 L 19.86 16.95 A 2 2 0 1 1 17 19.81 L 16.87 19.68 A 1.65 1.65 0 0 0 15.05 19.35 V 19.5 A 2 2 0 1 1 11 19.5 V 19.35 A 1.65 1.65 0 0 0 9.23 19.68 L 9.1 19.81 A 2 2 0 1 1 6.24 16.95 L 6.37 16.82 A 1.65 1.65 0 0 0 6.04 15 H 5.89 A 2 2 0 1 1 5.89 11 H 6.04 A 1.65 1.65 0 0 0 6.37 9.18 L 6.24 9.05 A 2 2 0 1 1 9.1 6.19 L 9.23 6.32 A 1.65 1.65 0 0 0 11.05 6.65 V 6.5 A 2 2 0 1 1 15.05 6.5 V 6.65 A 1.65 1.65 0 0 0 16.87 6.32 L 17 6.19 A 2 2 0 1 1 19.86 9.05 L 19.73 9.18 A 1.65 1.65 0 0 0 19.4 11 H 19.55 A 2 2 0 1 1 19.55 15 Z" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                            <tooltip><Tooltip text="Cài đặt thông số &amp; Quy định thư viện"/></tooltip>
                        </Button>
                    </VBox>
                </ScrollPane>

                <!-- Bottom System Status & Help -->
                <VBox spacing="6" style="-fx-padding: 8 4 0 4;">
                    <Separator style="-fx-background-color: #222222;"/>
                    <Button fx:id="btnHelp" text="Hướng dẫn (SRS)" onAction="#handleHelpClick" maxWidth="Infinity"
                            styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 10;">
                        <graphic>
                            <SVGPath mouseTransparent="true" content="M 12 22 A 10 10 0 1 0 12 2 A 10 10 0 0 0 12 22 Z M 9.09 9 A 3 3 0 0 1 15 10 C 15 12 12 13 12 13 M 12 17 H 12.01" styleClass="sidebar-svg-icon" scaleX="0.7" scaleY="0.7"/>
                        </graphic>
                        <tooltip><Tooltip text="Hướng dẫn sử dụng hệ thống (SRS)"/></tooltip>
                    </Button>
                    <HBox fx:id="sidebarRoleBox" alignment="CENTER_LEFT" spacing="6">
                        <Label text="Vai trò:" styleClass="text-muted"/>
                        <Label fx:id="lblCurrentRoleBadge" text="Chưa đăng nhập" style="-fx-text-fill: #F59E0B; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </left>

        <!-- CENTER CONTENT CONTAINER -->
        <center>
            <StackPane fx:id="contentArea" styleClass="bg-dark">
                <!-- Dynamic view injected here -->
            </StackPane>
        </center>

    </BorderPane>

    <!-- LAYER 2: SPOTIFY-LIKE INSTANT SEARCH FLOATING DROPDOWN (STRAIGHT COLUMN ALIGNMENT) -->
    <VBox fx:id="searchDropdownContainer" visible="false" managed="false"
          alignment="TOP_LEFT" maxWidth="460" maxHeight="380"
          styleClass="search-dropdown"
          StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets top="56" left="266"/>
        </StackPane.margin>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <VBox fx:id="searchDropdownList" spacing="2" style="-fx-background-color: transparent;">
                <!-- Populated dynamically via controller -->
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- LAYER 3: IN-WINDOW OVERLAY MODAL (DIMMED & BLURRED BACKDROP) -->
    <StackPane fx:id="authOverlayPane" visible="false" managed="false" styleClass="auth-overlay">
        <!-- Overlay backdrop click handler closes popup -->
        <Pane onMouseClicked="#closeAuthPopup"/>

        <!-- CARD 1: DYNAMIC AUTH MODAL (LOGIN & REGISTER) -->
        <VBox fx:id="authModalBox" maxWidth="460" maxHeight="620" styleClass="auth-modal" spacing="16">
            <!-- VIEW A: ĐĂNG NHẬP (DEFAULT) -->
            <VBox fx:id="loginViewBox" spacing="16">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Đăng Nhập LibMan" styleClass="title-large"/>
                        <Label text="Chào mừng bạn quay trở lại thư viện" styleClass="text-muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✕" onAction="#closeAuthPopup" styleClass="btn-secondary" style="-fx-padding: 4 10; -fx-background-radius: 50%;"/>
                </HBox>

                <!-- Input Fields -->
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                    </columnConstraints>
                    <Label text="Tài Khoản:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtLoginUsername" promptText="quantri / thuthu / docgia" styleClass="form-control" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Mật Khẩu:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="txtLoginPassword" promptText="Nhập mật khẩu" styleClass="form-control" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Quick Selection Buttons -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Chọn nhanh:" style="-fx-text-fill: #727272; -fx-font-size: 11px;"/>
                    <Button text="Quản Trị" onAction="#fillAdminLogin" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3 8;"/>
                    <Button text="Thủ Thư" onAction="#fillLibrarianLogin" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3 8;"/>
                    <Button text="Độc Giả" onAction="#fillReaderLogin" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3 8;"/>
                </HBox>

                <Label fx:id="lblLoginError" text="" style="-fx-font-weight: bold;"/>

                <!-- Switch to Register Link directly above Login Button -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Đăng ký nếu chưa có tài khoản." styleClass="auth-link" onMouseClicked="#switchToRegisterView"/>
                </HBox>

                <HBox spacing="12">
                    <Button text="Đăng Nhập Ngay" onAction="#handleExecuteLogin" styleClass="btn-primary"/>
                    <Button text="Đóng" onAction="#closeAuthPopup" styleClass="btn-secondary"/>
                </HBox>
            </VBox>

