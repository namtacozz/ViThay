            <!-- Optional Details / Previews / Slip View -->
            <TextArea fx:id="txtNoticeDetails" editable="false" wrapText="true" visible="false" managed="false" prefHeight="260" styleClass="wizard-slip-preview" style="-fx-font-family: monospace; -fx-font-size: 11px;"/>

            <!-- Action Buttons -->
            <HBox fx:id="boxNoticeActions" spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="btnNoticeCancel" text="Hủy Bỏ" onAction="#handleNoticeCancel" styleClass="btn-secondary" style="-fx-padding: 8 16;"/>
                <Button fx:id="btnNoticeConfirm" text="Đồng Ý" onAction="#handleNoticeConfirm" styleClass="btn-primary" style="-fx-padding: 8 20;"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
