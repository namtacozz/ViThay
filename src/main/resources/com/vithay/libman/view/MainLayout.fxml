        <!-- CARD 3: IN-APP SRS HELP MODAL (PROFESSIONAL CARDS & TYPOGRAPHY) -->
        <VBox fx:id="helpModalBox" id="helpModalBox" maxWidth="700" maxHeight="640" styleClass="auth-modal" spacing="16" visible="false" managed="false">
