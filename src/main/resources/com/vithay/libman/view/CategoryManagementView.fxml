<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="categoryRootPane"
           fx:controller="com.vithay.libman.controller.CategoryController"
           stylesheets="@../css/style.css" styleClass="bg-dark">

    <!-- MAIN VIEW CONTAINER -->
    <VBox fx:id="categoryMainContainer" spacing="16" styleClass="bg-dark">
        <padding>
            <Insets top="24" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Header & Action Bar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Quản Lý Thể Loại Sách" styleClass="title-large"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleOpenAddCategory" styleClass="btn-primary" style="-fx-padding: 6 14;">
                <graphic>
                    <HBox alignment="CENTER" spacing="6">
                        <SVGPath content="M 19 13 h -6 v 6 h -2 v -6 H 5 v -2 h 6 V 5 h 2 v 6 h 6 v 2 Z" fill="#000000" scaleX="0.65" scaleY="0.65"/>
                        <Label text="Thêm" style="-fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="Tạo thể loại phân mục sách mới"/></tooltip>
            </Button>
            <Button onAction="#loadCategories" styleClass="btn-circle, btn-secondary">
                <graphic>
                    <SVGPath content="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 H 17.65 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 H 20 V 4 L 17.65 6.35 Z" fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/>
                </graphic>
                <tooltip><Tooltip text="Làm mới danh sách thể loại"/></tooltip>
            </Button>
        </HBox>

        <!-- Search Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bg-surface">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Tìm kiếm:" styleClass="form-label"/>
            <TextField fx:id="txtSearchCategory" promptText="Tìm theo tên thể loại hoặc mô tả..." prefWidth="320"
                       styleClass="search-field" onKeyReleased="#handleSearchCategory"/>
        </HBox>

        <!-- Table View -->
        <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS" prefHeight="450">
            <columns>
                <TableColumn fx:id="colCatId" text="Mã" prefWidth="120"/>
                <TableColumn fx:id="colCatName" text="Tên Thể Loại" prefWidth="240"/>
                <TableColumn fx:id="colCatDesc" text="Mô Tả" prefWidth="400"/>
                <TableColumn fx:id="colCatActions" text="Thao Tác" prefWidth="160"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- IN-WINDOW OVERLAY MODAL FOR ADD/EDIT CATEGORY -->
    <StackPane fx:id="categoryModalOverlay" visible="false" managed="false" styleClass="auth-overlay">
        <Pane onMouseClicked="#closeCategoryModal"/>
        <VBox fx:id="categoryModalBox" maxWidth="480" maxHeight="-Infinity" StackPane.alignment="CENTER" styleClass="auth-modal" spacing="14">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label fx:id="lblCategoryModalTitle" text="Thêm Thể Loại Mới" styleClass="title-large"/>
                    <Label text="Nhập thông tin phân loại sách theo chuẩn biên mục thư viện" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#closeCategoryModal" styleClass="btn-secondary" style="-fx-padding: 4 10; -fx-background-radius: 50%;"/>
            </HBox>

            <GridPane hgap="12" vgap="12" style="-fx-padding: 6 0 6 0;">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="240"/>
                </columnConstraints>

                <Label text="Tên Thể Loại:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtModalCatName" promptText="VD: Khoa học viễn tưởng" styleClass="form-control" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Mô Tả Chi Tiết:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtModalCatDesc" promptText="Mô tả nhóm sách và nội dung bao quát" styleClass="form-control" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="lblCategoryModalError" text="" style="-fx-font-weight: bold;"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Hủy Bỏ" onAction="#closeCategoryModal" styleClass="btn-secondary"/>
                <Button text="Lưu Thể Loại" onAction="#handleSaveCategoryModal" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
