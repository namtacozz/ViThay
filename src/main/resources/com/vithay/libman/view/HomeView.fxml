<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vithay.libman.controller.HomeController"
      spacing="12" styleClass="bg-dark" stylesheets="@../css/style.css">
    <padding>
        <Insets top="12" right="24" bottom="12" left="24"/>
    </padding>

    <!-- Hidden greeting label for test compatibility & state management -->
    <Label fx:id="lblGreeting" text="Xin chào!" visible="false" managed="false"/>

    <!-- Quick Stats Cards Row (Always Visible) -->
    <HBox fx:id="statsCardsContainer" spacing="12">
        <VBox fx:id="cardTotalBooks" onMouseClicked="#handleCardTotalBooks" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 8 14;">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <SVGPath mouseTransparent="true" content="M 4 6 H 20 V 18 H 4 Z M 6 8 V 16 H 18 V 8 Z" fill="#B3B3B3" scaleX="0.7" scaleY="0.7"/>
                <Label text="TỔNG ĐẦU SÁCH" styleClass="stat-label" style="-fx-font-size: 11px;"/>
            </HBox>
            <Label fx:id="lblTotalBooks" text="0" styleClass="stat-value" style="-fx-font-size: 20px;"/>
        </VBox>
        <VBox fx:id="cardAvailableBooks" onMouseClicked="#handleCardAvailableBooks" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 8 14;">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <SVGPath mouseTransparent="true" content="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 Z" fill="#1DB954" scaleX="0.65" scaleY="0.65"/>
                <Label text="SẴN SÀNG" styleClass="stat-label" style="-fx-font-size: 11px;"/>
            </HBox>
            <Label fx:id="lblAvailableBooks" text="0" styleClass="stat-value" style="-fx-text-fill: #1DB954; -fx-font-size: 20px;"/>
        </VBox>
        <VBox fx:id="cardBorrowedBooks" onMouseClicked="#handleCardBorrowedBooks" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 8 14;">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <SVGPath mouseTransparent="true" content="M 11.99 2 C 6.47 2 2 6.48 2 12 C 2 17.52 6.47 22 11.99 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 11.99 2 Z M 12 20 C 7.58 20 4 16.42 4 12 C 4 7.58 7.58 4 12 4 C 16.42 4 20 7.58 20 12 C 20 16.42 16.42 20 12 20 Z M 12.5 7 H 11 V 13 L 16.25 16.15 L 17 14.92 L 12.5 12.25 Z" fill="#F59E0B" scaleX="0.65" scaleY="0.65"/>
                <Label text="ĐANG MƯỢN" styleClass="stat-label" style="-fx-font-size: 11px;"/>
            </HBox>
            <Label fx:id="lblBorrowedBooks" text="0" styleClass="stat-value" style="-fx-text-fill: #F59E0B; -fx-font-size: 20px;"/>
        </VBox>
        <VBox fx:id="cardTotalReaders" onMouseClicked="#handleCardTotalReaders" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 8 14;">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <SVGPath mouseTransparent="true" content="M 12 12 C 14.21 12 16 10.21 16 8 C 16 5.79 14.21 4 12 4 C 9.79 4 8 5.79 8 8 C 8 10.21 9.79 12 12 12 Z M 12 14 C 9.33 14 4 15.34 4 18 V 20 H 20 V 18 C 20 15.34 14.67 14 12 14 Z" fill="#38BDF8" scaleX="0.65" scaleY="0.65"/>
                <Label text="ĐỘC GIẢ" styleClass="stat-label" style="-fx-font-size: 11px;"/>
            </HBox>
            <Label fx:id="lblTotalReaders" text="0" styleClass="stat-value" style="-fx-text-fill: #38BDF8; -fx-font-size: 20px;"/>
        </VBox>
    </HBox>

    <!-- Featured Books Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Sách nổi bật" styleClass="title-medium" style="-fx-font-size: 15px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Xem tất cả →" onAction="#handleViewAllBooks" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 12;"/>
    </HBox>

    <!-- Featured Books Cards Container (Dedicated Horizontal ScrollPane with mouse-wheel scroll) -->
    <ScrollPane fx:id="featuredScrollPane" fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="NEVER"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;"
                styleClass="featured-scroll-pane">
        <HBox fx:id="featuredBooksContainer" spacing="14" alignment="CENTER_LEFT"
              style="-fx-background-color: transparent;">
            <!-- Book cards generated dynamically via HomeController -->
        </HBox>
    </ScrollPane>

    <!-- Recent Borrowing Transactions Section -->
    <VBox fx:id="recentTransactionsSection" spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Giao Dịch Mượn Sách Gần Đây" styleClass="title-medium" style="-fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleNewBorrow" styleClass="btn-primary" style="-fx-font-size: 11px; -fx-padding: 5 12;">
                <graphic>
                    <HBox alignment="CENTER" spacing="5">
                        <SVGPath content="M 19 13 h -6 v 6 h -2 v -6 H 5 v -2 h 6 V 5 h 2 v 6 h 6 v 2 Z" fill="#000000" scaleX="0.6" scaleY="0.6"/>
                        <Label text="Lập phiếu mượn" style="-fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="Lập phiếu mượn sách mới"/></tooltip>
            </Button>
            <Button onAction="#refreshData" styleClass="btn-circle, btn-secondary">
                <graphic>
                    <SVGPath content="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 H 17.65 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 H 20 V 4 L 17.65 6.35 Z" fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/>
                </graphic>
                <tooltip><Tooltip text="Làm mới danh sách giao dịch"/></tooltip>
            </Button>
        </HBox>

        <!-- Table of Recent Transactions -->
        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS" minHeight="140">
            <columns>
                <TableColumn fx:id="colTxId" text="Mã Giao Dịch" prefWidth="120"/>
                <TableColumn fx:id="colReaderName" text="Độc Giả" prefWidth="170"/>
                <TableColumn fx:id="colBookTitle" text="Tên Sách" prefWidth="260"/>
                <TableColumn fx:id="colBorrowDate" text="Ngày Mượn" prefWidth="110"/>
                <TableColumn fx:id="colDueDate" text="Hạn Trả" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Trạng Thái" prefWidth="110"/>
                <TableColumn fx:id="colAction" text="Hành Động" prefWidth="110"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
