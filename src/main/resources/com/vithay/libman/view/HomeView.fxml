<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vithay.libman.controller.HomeController"
            fitToWidth="true" fitToHeight="false"
            styleClass="bg-dark" stylesheets="@../css/style.css">

    <VBox spacing="24" styleClass="bg-dark">
        <padding>
            <Insets top="24" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Greeting Section -->
        <VBox spacing="4">
            <Label fx:id="lblGreeting" text="Xin chào, Nguyễn Minh Trí!" styleClass="greeting-text"/>
            <Label text="Chúc một ngày tốt lành. Chào mừng bạn đến với hệ thống quản lý thư viện LibMan." styleClass="greeting-subtext"/>
        </VBox>

        <!-- Quick Stats Header & Toggle -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Chỉ Số Hoạt Động Thư Viện" styleClass="title-medium" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnToggleStats" text="Thu gọn chỉ số ▴" onAction="#handleToggleStats" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3 10;"/>
        </HBox>

        <!-- Quick Stats Cards Row (Collapsible) -->
        <HBox fx:id="statsCardsContainer" spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <SVGPath content="M 4 6 H 20 V 18 H 4 Z M 6 8 V 16 H 18 V 8 Z" fill="#B3B3B3" scaleX="0.8" scaleY="0.8"/>
                    <Label text="TỔNG ĐẦU SÁCH" styleClass="stat-label"/>
                </HBox>
                <Label fx:id="lblTotalBooks" text="0" styleClass="stat-value"/>
                <Label text="Sách lưu trữ trong kho" styleClass="text-muted"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <SVGPath content="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 Z" fill="#1DB954" scaleX="0.7" scaleY="0.7"/>
                    <Label text="SÁCH SẴN SÀNG" styleClass="stat-label"/>
                </HBox>
                <Label fx:id="lblAvailableBooks" text="0" styleClass="stat-value" style="-fx-text-fill: #1DB954;"/>
                <Label text="Có thể mượn ngay" styleClass="text-muted"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <SVGPath content="M 11.99 2 C 6.47 2 2 6.48 2 12 C 2 17.52 6.47 22 11.99 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 11.99 2 Z M 12 20 C 7.58 20 4 16.42 4 12 C 4 7.58 7.58 4 12 4 C 16.42 4 20 7.58 20 12 C 20 16.42 16.42 20 12 20 Z M 12.5 7 H 11 V 13 L 16.25 16.15 L 17 14.92 L 12.5 12.25 Z" fill="#F59E0B" scaleX="0.7" scaleY="0.7"/>
                    <Label text="ĐANG ĐƯỢC MƯỢN" styleClass="stat-label"/>
                </HBox>
                <Label fx:id="lblBorrowedBooks" text="0" styleClass="stat-value" style="-fx-text-fill: #F59E0B;"/>
                <Label text="Đang lưu hành bên ngoài" styleClass="text-muted"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <SVGPath content="M 12 12 C 14.21 12 16 10.21 16 8 C 16 5.79 14.21 4 12 4 C 9.79 4 8 5.79 8 8 C 8 10.21 9.79 12 12 12 Z M 12 14 C 9.33 14 4 15.34 4 18 V 20 H 20 V 18 C 20 15.34 14.67 14 12 14 Z" fill="#38BDF8" scaleX="0.7" scaleY="0.7"/>
                    <Label text="ĐỘC GIẢ HỢP LỆ" styleClass="stat-label"/>
                </HBox>
                <Label fx:id="lblTotalReaders" text="0" styleClass="stat-value" style="-fx-text-fill: #38BDF8;"/>
                <Label text="Thành viên đã kích hoạt" styleClass="text-muted"/>
            </VBox>
        </HBox>

        <!-- Featured Books Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Sách nổi bật" styleClass="title-medium"/>
                <Label text="Các đầu sách được quan tâm nhiều nhất trong thư viện" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Xem tất cả kho sách →" onAction="#handleViewAllBooks" styleClass="btn-secondary"/>
        </HBox>

        <!-- Featured Books Cards Container (Responsive FlowPane or HBox) -->
        <HBox fx:id="featuredBooksContainer" spacing="16" alignment="CENTER_LEFT">
            <!-- Book cards generated dynamically via HomeController -->
        </HBox>

        <!-- Recent Borrowing Transactions Section -->
        <VBox spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Giao Dịch Mượn Sách Gần Đây" styleClass="title-medium"/>
                    <Label text="Danh sách các phiếu mượn phát sinh gần đây" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Lập phiếu mượn" onAction="#handleNewBorrow" styleClass="btn-primary"/>
                <Button text="Làm mới" onAction="#refreshData" styleClass="btn-secondary"/>
            </HBox>

            <!-- Table of Recent Transactions -->
            <TableView fx:id="transactionsTable" prefHeight="260" minHeight="240">
                <columns>
                    <TableColumn fx:id="colTxId" text="Mã Giao Dịch" prefWidth="130"/>
                    <TableColumn fx:id="colReaderName" text="Độc Giả" prefWidth="180"/>
                    <TableColumn fx:id="colBookTitle" text="Tên Sách" prefWidth="280"/>
                    <TableColumn fx:id="colBorrowDate" text="Ngày Mượn" prefWidth="120"/>
                    <TableColumn fx:id="colDueDate" text="Hạn Trả" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Trạng Thái" prefWidth="130"/>
                    <TableColumn fx:id="colAction" text="Hành Động" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
